node_modules/
.next/
.next-*/
# The whole data dir, not just *.db / *.db-*. Those two patterns missed the
# point-in-time snapshots (founder-os.db.bak-<sha> contains ".db.bak-", never
# the literal ".db-"), so all 11 of them read as plain untracked files and
# `git clean -fd` — the SAFE variant — deleted every backup of the database.
# See OS-330. This still does nothing against `git clean -fdx`: -x means "also
# remove ignored files", so gitignoring a database is a no-op against it. The
# only real fix there is keeping the data outside the repo — see DATA_DIR in
# lib/paths.ts and .env.example.
data/
*.tsbuildinfo
next-env.d.ts
.DS_Store
.worktrees/
.playwright-mcp/
claude code images/
dir-sidebar.jpeg

# Firecrawl scratch (scraped API docs, tokens) — never commit.
.firecrawl/

# Secrets — never commit real credentials. Only .env.example is tracked.
.env
.env.local
.env.*.local

.vercel

# local run artifacts and caches, never source
agents/markets/journal/
rosters/
data/candles/
.sanitize.mjs

node_modules
